# /etc/systemd/system/mnist-ai.service
# sudo systemctl daemon-reload && sudo systemctl enable --now mnist-ai

[Unit]
Description=MNIST AI (Gunicorn + Flask)
After=network.target

[Service]
User=mnist
Group=www-data
WorkingDirectory=/opt/mnist-ai
EnvironmentFile=/opt/mnist-ai/.env
ExecStart=/opt/mnist-ai/.venv/bin/gunicorn -c deploy/gunicorn.conf.py wsgi:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
