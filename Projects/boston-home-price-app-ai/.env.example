# Copy to .env and fill in. Never commit .env.
APP_ENV=production                 # production | development | testing
SECRET_KEY=change-me-generate-with-python-secrets-token-hex-32
LOG_LEVEL=INFO

# Paths are relative to the project root unless absolute
MODEL_PATH=models/boston_home_price_prediction.h5
PREPROCESSING_PATH=models/preprocessing.json
MODEL_EAGER_LOAD=true

# Request body limit in bytes (a prediction request is ~300 bytes)
MAX_CONTENT_LENGTH=16384

# Set to true only when served over HTTPS
ENABLE_HSTS=false

# Gunicorn
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
