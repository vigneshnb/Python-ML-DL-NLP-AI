# /etc/systemd/system/home-value-estimator.service
[Unit]
Description=Home Value Estimator (Flask + Gunicorn)
After=network.target

[Service]
Type=simple
User=hve
Group=www-data
WorkingDirectory=/opt/home-value-estimator
EnvironmentFile=/opt/home-value-estimator/.env
# Keras writes a small config file on import; keep it in the private /tmp
Environment=KERAS_HOME=/tmp/.keras
ExecStart=/opt/home-value-estimator/.venv/bin/gunicorn -c deploy/gunicorn.conf.py wsgi:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
KillMode=mixed

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/home-value-estimator
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
