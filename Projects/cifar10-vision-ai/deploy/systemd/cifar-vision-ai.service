# /etc/systemd/system/cifar-vision-ai.service
[Unit]
Description=CIFAR Vision AI (Gunicorn)
After=network.target

[Service]
Type=simple
User=cifar
Group=www-data
WorkingDirectory=/opt/cifar-vision-ai
EnvironmentFile=/opt/cifar-vision-ai/.env
Environment="PATH=/opt/cifar-vision-ai/.venv/bin"
ExecStart=/opt/cifar-vision-ai/.venv/bin/gunicorn -c deploy/gunicorn.conf.py wsgi:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
KillMode=mixed

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
