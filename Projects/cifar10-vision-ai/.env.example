# Copy to .env and adjust. Never commit the real .env.
APP_ENV=production            # production | development | testing
SECRET_KEY=change-me-to-a-long-random-string   # python -c "import secrets;print(secrets.token_hex(32))"

# Model (absolute path recommended in production)
MODEL_PATH=models/cifar10_pred.h5
MODEL_EAGER_LOAD=true

# Upload limits
MAX_UPLOAD_MB=5
MIN_IMAGE_DIMENSION=8
MAX_IMAGE_DIMENSION=6000

LOG_LEVEL=INFO
ENABLE_HSTS=true              # only when served over HTTPS

# Local dev server (run.py)
HOST=127.0.0.1
PORT=5000

# Quieter TensorFlow logs
TF_CPP_MIN_LOG_LEVEL=2
