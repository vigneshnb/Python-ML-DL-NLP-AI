# Copy to .env and adjust. Never commit the real .env file.

# development | production | testing
APP_ENV=production

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Model + preprocessing
MODEL_PATH=models/digit_brain_intel.h5
# mnist    -> MNIST-style normalisation (recommended for real-world uploads)
# notebook -> exact notebook steps: grayscale -> resize 28x28 -> /255
PREPROCESS_MODE=mnist

# Upload limits
MAX_UPLOAD_MB=5
MIN_IMAGE_DIM=8
MAX_IMAGE_DIM=4096

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Dev server (python run.py)
HOST=127.0.0.1
PORT=5000

# Gunicorn (deploy/gunicorn.conf.py)
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60

# Reduce TensorFlow console noise
TF_CPP_MIN_LOG_LEVEL=2
