   "source": [
    "#### 1.\tWrite a program to take a name and age from the user and print a greeting message."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "a6fb2128-57f3-45d4-8ca3-52e94a2b8159",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter your name vignesh\n",
      "Enter your age 33\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Vignesh is 33 years old.\n"
     ]
    }
   ],
   "source": [
    "name = input('Enter your name')\n",
    "age = input('Enter your age')\n",
    "\n",
    "print(f\"{name.capitalize()} is {age} years old.\")"
   ]
  },
